# =============================================================================
# Praesync Backend Environment Variables Template
# Copy this file to .env and configure your credentials
# =============================================================================

# GitHub Personal Access Token (Requires 'contents:write' and 'pull_requests:write')
GITHUB_PAT=your_github_pat_here

# Target GitHub Repository (Format: owner/repo)
GITHUB_REPO=your_username/your_repo

# Google Gemini API Key (Gemini-3.5-Flash ReAct Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# LiteLLM Model Target
LITELLM_MODEL=gemini/gemini-3.5-flash

# Slack Incoming Webhook URL (For Switch Slack War Room notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Target file path for autonomous hotpatch synthesis
HOTFIX_TARGET_FILE=app/database/connection.py

